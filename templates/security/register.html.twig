{% extends 'base.html.twig' %}

{% block title %}Créer un compte | SCRUTIO{% endblock %}

{% block body %}
    <header class="topbar">
        <a class="wordmark" href="{{ path('case_index') }}">
            <span class="brand-mark" aria-hidden="true">S</span>
            <span>SCRUTIO</span>
        </a>
        <span class="topbar-caption">Cabinet d’expertise documentaire</span>
        <a class="account-nav-link" href="{{ path('app_login') }}">Connexion</a>
    </header>

    <main class="auth-shell">
        <p class="eyebrow">Espace analyste</p>
        <h1>Créer un compte</h1>
        <p class="intro-copy">Votre progression sera associée à votre profil joueur. Vous devrez confirmer votre email avant de vous connecter.</p>

        {% for error in errors %}
            <p class="auth-error" role="alert">{{ error }}</p>
        {% endfor %}

        <form class="auth-form" action="{{ path('app_register') }}" method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('register') }}">
            <label for="register-display-name">Pseudo</label>
            <input id="register-display-name" type="text" name="display_name" value="{{ displayName }}" maxlength="80" autocomplete="nickname" required>
            <label for="register-email">Adresse email</label>
            <input id="register-email" type="email" name="email" value="{{ email }}" maxlength="180" autocomplete="email" required>
            <label for="register-password">Mot de passe <span>(12 caractères minimum)</span></label>
            <input id="register-password" type="password" name="password" minlength="12" maxlength="4096" autocomplete="new-password" required>
            <label for="register-password-confirmation">Confirmer le mot de passe</label>
            <input id="register-password-confirmation" type="password" name="password_confirmation" minlength="12" maxlength="4096" autocomplete="new-password" required>
            <button class="primary-action" type="submit">Créer mon compte</button>
        </form>
    </main>
{% endblock %}